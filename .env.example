# Canonical origin used by canonical URLs, Open Graph tags and sitemap.xml.
# Optional in Vercel: defaults to https://josmarsala.vercel.app.
VITE_SITE_URL=https://josmarsala.vercel.app

# Optional origin for media paths that are still relative (served from /public).
# Portfolio media now uses absolute Vercel Blob URLs from
# src/config/cdn-assets-map.json, so leave this empty unless you add new local
# assets. Example: https://cdn.example.com/portfolio
VITE_MEDIA_BASE_URL=

# Vercel Blob — SERVER-SIDE ONLY.
# Never prefix this with VITE_: that would expose the token in the client bundle.
# `vercel blob create-store` adds this automatically to the Vercel project and
# to .env.local for local scripts.
BLOB_READ_WRITE_TOKEN=
