# Canonical origin used by canonical URLs, Open Graph tags and sitemap.xml.
# Optional in Vercel: defaults to https://josmarsala.vercel.app.
VITE_SITE_URL=https://josmarsala.vercel.app

# Optional origin for media paths that are still relative (served from /public).
# Portfolio media ships from public/media and resolves to same-origin /media/…
# paths via src/config/cdn-assets-map.json, so leave this empty unless you add
# assets on another origin. Example: https://cdn.example.com/portfolio
VITE_MEDIA_BASE_URL=

# Optional Vercel Blob token for scripts/upload-cdn-assets.mjs. Not needed by
# the app or the production build: media is committed under public/media.
BLOB_READ_WRITE_TOKEN=
